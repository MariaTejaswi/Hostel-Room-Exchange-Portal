{
  "name": "roomloop-frontend",
  "version": "1.0.0",
  "description": "Tailwind CSS build pipeline for RoomLoop Portal",
  "scripts": {
    "build:css": "tailwindcss -i ./frontend/src/input.css -o ./static/css/dist/styles.css --minify",
    "watch:css": "tailwindcss -i ./frontend/src/input.css -o ./static/css/dist/styles.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16"
  }
}
