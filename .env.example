# ==============================================================================
# RoomLoop Environment Configuration
# ==============================================================================

# Django Core Settings
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=django-insecure-roomloop-dev-secret-key-change-in-production-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL 16)
# Note: For Docker setup, host is 'db'. For local setup, host is 'localhost'.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roomloop_db
DB_ENGINE=django.db.backends.postgresql
DB_NAME=roomloop_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery Infrastructure
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email Backend (console for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=RoomLoop Portal <notifications@roomloop.edu>

# Security / Session Settings
SESSION_COOKIE_AGE=86400
SESSION_EXPIRE_AT_BROWSER_CLOSE=False

# Demo Seeding Credentials (Used by python manage.py seed_demo)
DEMO_SUPERUSER_EMAIL=admin@roomloop.edu
DEMO_SUPERUSER_PASSWORD=AdminPassword123!
DEMO_DEFAULT_PASSWORD=RoomLoop2026!
